# Copy to .env.local and fill in. .env.local is gitignored. Only NEXT_PUBLIC_ values
# are exposed to the browser, so never put a secret in any of these.

# Use fake data (MSW) instead of the real API. Keep "true" until the backend is deployed.
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the deployed API, including /v1 (CfnOutput "API URL"). Not needed while mocks are on.
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/v1

# Staff sign-in (Cognito). Values come from the AuthStack CfnOutputs. Not needed while mocks are on.
NEXT_PUBLIC_AWS_REGION=us-west-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-west-2_example
NEXT_PUBLIC_COGNITO_CLIENT_ID=example-client-id
