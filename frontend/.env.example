# Copy to .env.local and fill in. .env.local is gitignored. Only NEXT_PUBLIC_ values
# are exposed to the browser, so never put a secret in any of these.
# Keep this "false". "true" skips the API and is only for working on the screens without a backend.
NEXT_PUBLIC_USE_MOCKS=false
# Base URL of the deployed API, including /v1 (stack output "ApiUrl" plus /v1).
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/v1
# Staff sign-in (Cognito). Values come from the stack outputs UserPoolId and UserPoolClientId.
NEXT_PUBLIC_AWS_REGION=us-west-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-west-2_example
NEXT_PUBLIC_COGNITO_CLIENT_ID=example-client-id
# Where Python for coding exercises (Pyodide, about 12 MB) is loaded from. The default is the public CDN.
# Set this to a copy you host yourself (with a trailing slash) if school networks block jsdelivr.net.
# NEXT_PUBLIC_PYODIDE_URL=https://cdn.jsdelivr.net/pyodide/v314.0.8/full/
