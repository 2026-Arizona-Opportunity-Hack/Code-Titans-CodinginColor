{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "test",
      "**/__pycache__"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "allowedOrigins": "https://main.d3voqx7r17ipz6.amplifyapp.com,http://localhost:3000",
    "staffMfa": "REQUIRED",
    "bedrockRegion": "us-west-2",
    "hintModelId": "amazon.nova-lite-v1:0",
    "hintsMonthlyCap": 5000
  }
}
